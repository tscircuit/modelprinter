{
  "name": "@tscircuit/modelprinter",
  "version": "0.0.3",
  "description": "Parametric CAD model strings and schemas for tscircuit",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "index.js.map"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean && bun scripts/prepare-package.ts",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "snapshot:bolts": "BUN_UPDATE_SNAPSHOTS=1 bun test tests/hex-socket-bolt.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tscircuit/modelprinter.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "license": "MIT",
  "keywords": [
    "tscircuit",
    "cad",
    "jscad",
    "model",
    "dsl"
  ],
  "dependencies": {
    "@tscircuit/mm": "^0.0.9",
    "earcut": "^3.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@tscircuit/alphabet": "^0.0.27",
    "@tscircuit/image-utils": "^0.0.10",
    "@types/earcut": "^3.0.0",
    "bun-types": "^1.4.0",
    "gl-matrix": "^3.4.4",
    "poppygl": "^0.0.29",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
