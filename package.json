{
  "name": "@tscircuit/modelprinter",
  "version": "0.0.2",
  "description": "Parametric CAD model strings and schemas for tscircuit",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "prepack": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "snapshot:bolts": "bun scripts/snapshot-bolts.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tscircuit/modelprinter.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "keywords": [
    "tscircuit",
    "cad",
    "jscad",
    "model",
    "dsl"
  ],
  "dependencies": {
    "@tscircuit/mm": "^0.0.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/three": "^0.186.0",
    "bun-types": "^1.4.0",
    "playwright": "^1.63.0",
    "three": "^0.186.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
